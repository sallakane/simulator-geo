# Copier en .env.local, remplir, `chmod 600`. Jamais commité.
#
#   dev  : APP_SECRET et POSTGRES_PASSWORD suffisent.
#   prod : TOUT ce fichier, et AVANT le premier démarrage (SPEC §13).

APP_SECRET=                     # openssl rand -hex 32

# ⚠️ POSTGRES_PASSWORD n'est lu qu'à l'INITIALISATION du volume Postgres. Le
# changer ensuite ne change rien : il faut `make fresh` (perte des données) ou
# un ALTER USER. À définir avant le premier `up`.
POSTGRES_PASSWORD=

# Doit reprendre le mot de passe ci-dessus. `database` = nom du service Compose.
DATABASE_URL="postgresql://app:CHANGEME@database:5432/zonage?serverVersion=16&charset=utf8"

# Port de loopback du VPS mutualisé — vérifier qu'il est libre AVANT (SPEC §13) :
#   ss -tlnp | grep 127.0.0.1:80
APP_HTTP_PORT=8085

# ⚠️ Sans MAILER_DSN réel en production, le repli e-mail des leads après trois
# échecs de relais (SPEC §6) est perdu en silence. En dev : smtp://mailer:1025.
MAILER_DSN=smtp://mailer:1025

# Utilisé par le worker Messenger, qui génère des liens hors contexte HTTP.
DEFAULT_URI=https://api.zonage.sallakane.cloud

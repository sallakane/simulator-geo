# Purge des leads livrés à J+30 (SPEC §5 et §9). Installer :
#   sudo cp infra/simulateur-purge.cron /etc/cron.d/simulateur-purge
#
# Ce n'est pas de l'hygiène : l'éditeur est SOUS-TRAITANT du partenaire au sens
# de l'article 28. Les données personnelles sont relayées, pas conservées. Si
# cette ligne ne tourne pas, l'engagement RGPD ne tient plus.
#
# 4 h 10 : après la sauvegarde de 3 h 40, pour que le dernier dump contienne
# encore ce qui va être purgé.
#
# `exec` ne recrée aucun conteneur : pas besoin des secrets d'interpolation.
# La commande app:leads:purge est livrée au lot 3 ; d'ici là, cette entrée ne
# doit PAS être installée (elle échouerait chaque nuit dans le log).

10 4 * * * deploy cd /var/www/simulateur && docker compose -f compose.prod.yaml exec -T app php bin/console app:leads:purge --no-interaction >> /var/log/simulateur-purge.log 2>&1

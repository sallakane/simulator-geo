# Fichier VERSIONNÉ — aucun secret ici (SPEC §15).
# Les valeurs réelles vont dans .env.local, jamais commité.
#
# Rappel Symfony : une VRAIE variable d'environnement l'emporte toujours sur ce
# fichier. C'est ce mécanisme, et lui seul, qui fait passer les secrets en
# production (compose.prod.yaml → env_file: .env.local).
#
# Docker Compose lit aussi ce fichier pour interpoler les ${...} — d'où les
# valeurs d'infrastructure en bas.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# `database` = nom du service Compose (pas localhost : on est dans un réseau Docker).
DATABASE_URL="postgresql://app:app@database:5432/zonage?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# auto_setup=0 : la table messenger_messages est créée explicitement par
# l'entrypoint (messenger:setup-transports), pas au premier envoi.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

# Base publique du service. JAMAIS d'URL en dur dans le code ni dans le widget
# (SPEC §1) : le sous-domaine changera.
DEFAULT_URI=http://localhost:8085

# ── Infrastructure (lu par Docker Compose) ───────────────────────────────────
# Port de loopback réservé au simulateur sur le VPS mutualisé (SPEC §13).
APP_HTTP_PORT=8085
POSTGRES_DB=zonage
POSTGRES_USER=app
# Défaut volontaire : permet à `exec`/`logs`/`ps` (crons) de fonctionner sans le
# secret. En production, le VRAI mot de passe est fourni au `up` par systemd.
POSTGRES_PASSWORD=app
# UID/GID sous lesquels tournent les conteneurs en dev, pour que les fichiers
# écrits dans le bind-mount appartiennent au développeur et non à root. `make`
# les exporte depuis `id -u`/`id -g` ; ces valeurs ne servent que de repli.
HOST_UID=1000
HOST_GID=1000
# Ports exposés sur le poste uniquement (compose.override.yaml).
DB_HOST_PORT=5435
MAILPIT_SMTP_PORT=1028
MAILPIT_UI_PORT=8028
